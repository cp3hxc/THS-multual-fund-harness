{
  "name": "fund-ai-workbench-desktop",
  "version": "1.0.0",
  "private": true,
  "author": "Paradox",
  "description": "场外基金 AI 工作台 Codex Harness Agent 桌面应用",
  "main": "desktop/main.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node scripts/run.js desktop",
    "start:web": "node scripts/run.js web",
    "test:python": "node scripts/python-tests.js",
    "build:desktop": "node scripts/package.js",
    "build:mac": "node scripts/package.js mac",
    "build:win": "node scripts/package.js win",
    "test:desktop": "node --test test_desktop_runtime.js"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.paradox.fund-ai-workbench",
    "productName": "基金 AI 工作台",
    "asar": true,
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "desktop/assets/icon.icns",
      "identity": null,
      "target": ["dmg"]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      { "from": "build/backend", "to": "backend" },
      { "from": "fund-ai-workbench.html", "to": "workbench/fund-ai-workbench.html" },
      { "from": "workbench.css", "to": "workbench/workbench.css" },
      { "from": "workbench.js", "to": "workbench/workbench.js" },
      { "from": "strategy-invest.css", "to": "workbench/strategy-invest.css" },
      { "from": "panda-strategy-agent.html", "to": "workbench/panda-strategy-agent.html" },
      { "from": "panda-strategy-agent.css", "to": "workbench/panda-strategy-agent.css" },
      { "from": "panda-strategy-agent-fixes.css", "to": "workbench/panda-strategy-agent-fixes.css" },
      { "from": "panda-strategy-agent.js", "to": "workbench/panda-strategy-agent.js" },
      { "from": "assets/paradoxai-mark.png", "to": "workbench/assets/paradoxai-mark.png" },
      { "from": "harness/skills/fund-workbench/SKILL.md", "to": "workbench/harness/skills/fund-workbench/SKILL.md" }
    ]
  }
}
